---
services:
  rustfs:
    image: "{{ rustfs_image }}"
    container_name: rustfs
    user: "{{ rustfs_uid }}:{{ rustfs_gid }}"
    command: ["/data"]
    environment:
      RUSTFS_ACCESS_KEY_FILE: /run/secrets/root-access-key
      RUSTFS_SECRET_KEY_FILE: /run/secrets/root-secret-key
      RUSTFS_ADDRESS: ":9000"
      RUSTFS_CONSOLE_ADDRESS: ":9001"
      RUSTFS_REGION: "{{ rustfs_region }}"
    volumes:
      - "{{ rustfs_data_dir }}:/data"
      - "{{ rustfs_secret_dir }}/root-access-key:/run/secrets/root-access-key:ro"
      - "{{ rustfs_secret_dir }}/root-secret-key:/run/secrets/root-secret-key:ro"
    ports:
      - "{{ rustfs_bind_address }}:{{ rustfs_api_port }}:9000"
      - "{{ rustfs_bind_address }}:{{ rustfs_console_port }}:9001"
    restart: "no"
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]

