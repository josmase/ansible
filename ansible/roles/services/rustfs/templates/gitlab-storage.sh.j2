#!/bin/sh
set -eu

root_access="$(tr -d '\r\n' < /bootstrap/root-access-key)"
root_secret="$(tr -d '\r\n' < /bootstrap/root-secret-key)"
gitlab_access="$(tr -d '\r\n' < /bootstrap/gitlab-access-key)"
gitlab_secret="$(tr -d '\r\n' < /bootstrap/gitlab-secret-key)"
tofu_access="$(tr -d '\r\n' < /bootstrap/tofu-state-access-key)"
tofu_secret="$(tr -d '\r\n' < /bootstrap/tofu-state-secret-key)"
registry_access="$gitlab_access"
registry_secret="$gitlab_secret"
endpoint="http://{{ rustfs_bind_address }}:{{ rustfs_api_port }}"

rc alias set root "$endpoint" "$root_access" "$root_secret" \
  --region "{{ rustfs_region }}" --bucket-lookup path >/dev/null

if [ "${1:-reconcile}" = "verify" ]; then
  rc admin user info root "$gitlab_access" >/dev/null
  rc admin user info root "$tofu_access" >/dev/null
  rc admin user info root "$registry_access" >/dev/null
  rc admin policy info root "{{ rustfs_gitlab_policy }}" >/dev/null
  rc admin policy info root "{{ rustfs_tofu_policy }}" >/dev/null
  rc admin policy info root "{{ rustfs_registry_policy }}" >/dev/null
{% for bucket in (rustfs_gitlab_buckets + rustfs_gitlab_backup_buckets + [rustfs_tofu_state_bucket]) | unique %}
  rc bucket list "root/{{ bucket }}" >/dev/null
{% endfor %}
  rc alias set gitlab "$endpoint" "$gitlab_access" "$gitlab_secret" \
    --region "{{ rustfs_region }}" --bucket-lookup path >/dev/null
{% for bucket in rustfs_gitlab_buckets %}
  rc bucket list "gitlab/{{ bucket }}" >/dev/null
{% endfor %}
{% for bucket in rustfs_gitlab_backup_buckets %}
  if rc bucket list "gitlab/{{ bucket }}" >/dev/null 2>&1; then
    echo "ERROR: GitLab object-storage identity can list backup bucket {{ bucket }}" >&2
    exit 1
  fi
{% endfor %}
  rc alias set tofu "$endpoint" "$tofu_access" "$tofu_secret" \
    --region "{{ rustfs_region }}" --bucket-lookup path >/dev/null
  rc bucket list "tofu/{{ rustfs_tofu_state_bucket }}" >/dev/null
{% for bucket in rustfs_gitlab_buckets + rustfs_gitlab_backup_buckets %}
{% if bucket != rustfs_tofu_state_bucket %}
  if rc bucket list "tofu/{{ bucket }}" >/dev/null 2>&1; then
    echo "ERROR: OpenTofu identity can list GitLab bucket {{ bucket }}" >&2
    exit 1
  fi
{% endif %}
{% endfor %}
  rc alias set registry "$endpoint" "$registry_access" "$registry_secret" \
    --region "{{ rustfs_region }}" --bucket-lookup path >/dev/null
  rc bucket list "registry/{{ rustfs_registry_bucket }}{{ rustfs_registry_rootdirectory }}" >/dev/null
  if rc bucket list "registry/{{ rustfs_registry_bucket }}/unrelated" >/dev/null 2>&1; then
    echo "ERROR: registry identity can list outside its assigned prefix" >&2
    exit 1
  fi
  exit 0
fi

{% for bucket in (rustfs_gitlab_buckets + rustfs_gitlab_backup_buckets + [rustfs_tofu_state_bucket]) | unique %}
if ! rc bucket list "root/{{ bucket }}" >/dev/null 2>&1; then
  rc bucket create "root/{{ bucket }}" --ignore-existing >/dev/null
  echo "CREATED:bucket"
fi
{% endfor %}

if ! rc admin user info root "$gitlab_access" >/dev/null 2>&1; then
  rc admin user add root "$gitlab_access" "$gitlab_secret" >/dev/null
  echo "CREATED:gitlab-user"
fi
if ! rc admin user info root "$tofu_access" >/dev/null 2>&1; then
  rc admin user add root "$tofu_access" "$tofu_secret" >/dev/null
  echo "CREATED:tofu-user"
fi

# Upsert desired policies; never remove buckets, objects, or other users.
rc admin policy create root "{{ rustfs_gitlab_policy }}" /bootstrap/gitlab-storage-policy.json >/dev/null
rc admin policy create root "{{ rustfs_tofu_policy }}" /bootstrap/tofu-state-policy.json >/dev/null
rc admin user info root "$registry_access" >/dev/null
if ! rc admin policy info root "{{ rustfs_registry_policy }}" >/dev/null 2>&1; then
  echo "CREATED:registry-policy"
fi
rc admin policy create root "{{ rustfs_registry_policy }}" /bootstrap/registry-storage-policy.json >/dev/null
rc admin policy attach root "{{ rustfs_gitlab_policy }},{{ rustfs_registry_policy }}" \
  --user "$gitlab_access" >/dev/null
rc admin policy attach root "{{ rustfs_tofu_policy }}" --user "$tofu_access" >/dev/null
