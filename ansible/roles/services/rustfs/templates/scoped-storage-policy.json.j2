{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": {{ item.buckets | map('regex_replace', '^', 'arn:aws:s3:::') | list | to_json }}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": {{ item.buckets | map('regex_replace', '^', 'arn:aws:s3:::') | map('regex_replace', '$', '/*') | list | to_json }}
    }
  ]
}
