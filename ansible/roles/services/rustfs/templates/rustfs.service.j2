[Unit]
Description=RustFS S3 backup target
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor={{ rustfs_required_mount }}
BindsTo=mnt-storage.mount
After=mnt-storage.mount

[Service]
Type=simple
WorkingDirectory={{ rustfs_compose_dir }}
ExecStartPre=/usr/bin/findmnt --target {{ rustfs_required_mount }} --types {{ rustfs_required_fstype }}
ExecStart=/usr/bin/docker compose --file {{ rustfs_compose_dir }}/compose.yml up --remove-orphans
ExecStop=/usr/bin/docker compose --file {{ rustfs_compose_dir }}/compose.yml down
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
